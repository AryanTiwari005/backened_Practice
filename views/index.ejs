<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mini Whatsapp</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: #e5ddd5;
            color: #111b21;
        }

        .app {
            max-width: 640px;
            min-height: 100vh;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            background: #efeae2;
            box-shadow: 0 0 20px rgba(0, 0, 0, 0.15);
        }

        header {
            background: #075e54;
            color: #fff;
            padding: 16px 20px;
            font-size: 1.2rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        header small {
            display: block;
            font-size: 0.75rem;
            font-weight: 400;
            opacity: 0.8;
        }

        .chats {
            flex: 1;
            list-style: none;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .chat {
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .avatar {
            flex-shrink: 0;
            width: 38px;
            height: 38px;
            border-radius: 50%;
            background: #25d366;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        .bubble {
            background: #fff;
            padding: 8px 12px;
            border-radius: 0 12px 12px 12px;
            max-width: 85%;
            box-shadow: 0 1px 1px rgba(0, 0, 0, 0.12);
            word-break: break-word;
        }

        .meta { font-size: 0.8rem; color: #075e54; font-weight: 600; }
        .meta span { color: #667781; font-weight: 400; }
        .msg { margin: 2px 0; }

        .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            margin-top: 4px;
        }

        .time { font-size: 0.7rem; color: #667781; }

        .delete-btn {
            border: none;
            background: none;
            color: #d93025;
            font-size: 0.7rem;
            cursor: pointer;
        }

        .delete-btn:hover { text-decoration: underline; }

        .empty {
            text-align: center;
            color: #667781;
            padding: 40px 0;
        }

        .send-form {
            position: sticky;
            bottom: 0;
            display: flex;
            gap: 8px;
            padding: 10px;
            background: #f0f2f5;
            border-top: 1px solid #d1d7db;
        }

        input {
            padding: 10px 14px;
            border: none;
            border-radius: 20px;
            font-size: 0.95rem;
            outline: none;
            min-width: 0;
        }

        input[name="from"], input[name="to"] { width: 22%; }
        input[name="msg"] { flex: 1; }

        .send-form button {
            border: none;
            background: #075e54;
            color: #fff;
            padding: 10px 18px;
            border-radius: 20px;
            font-size: 0.95rem;
            cursor: pointer;
        }

        .send-form button:hover { background: #128c7e; }

        @media (max-width: 480px) {
            .send-form { flex-wrap: wrap; }
            input[name="from"], input[name="to"] { width: calc(50% - 4px); }
            input[name="msg"] { flex: 1 1 100%; }
            .send-form button { width: 100%; }
        }
    </style>
</head>
<body>
    <div class="app">
        <header>
            MINI WHATSAPP
            <small><%= allchats.length %> message<%= allchats.length === 1 ? "" : "s" %></small>
        </header>

        <ul class="chats">
            <% if (allchats.length === 0) { %>
                <li class="empty">No messages yet. Send the first one below.</li>
            <% } %>

            <% for (let chat of allchats) { %>
                <li class="chat">
                    <div class="avatar"><%= chat.from.charAt(0).toUpperCase() %></div>
                    <div class="bubble">
                        <div class="meta"><%= chat.from %> <span>to <%= chat.to %></span></div>
                        <div class="msg"><%= chat.msg %></div>
                        <div class="footer">
                            <span class="time">
                                <%= new Date(chat.created_at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }) %>
                            </span>
                            <form action="/chats/<%= chat._id %>/delete" method="POST"
                                  onsubmit="return confirm('Delete this message?')">
                                <button class="delete-btn">Delete</button>
                            </form>
                        </div>
                    </div>
                </li>
            <% } %>
        </ul>

        <form class="send-form" action="/chats" method="POST">
            <input type="text" name="from" placeholder="from" required>
            <input type="text" name="to" placeholder="to" required>
            <input type="text" name="msg" placeholder="Type a message" maxlength="50" required>
            <button>Send</button>
        </form>
    </div>
</body>
</html>